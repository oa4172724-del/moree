.note{font-size:12px;color:var(--muted);line-height:1.8}
.contact{text-align:center;color:#c4cee8}
.contact a{color:var(--blue);direction:ltr;display:inline-block}
footer{border-top:1px solid #27325e;background:#040611;padding:28px 0}
.foot{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}
footer p{color:var(--muted);font-size:13px}
.reveal{opacity:0;transform:translateY(18px);transition:.7s}
.reveal.visible{opacity:1;transform:translateY(0)}
@media(max-width:850px){
.hero-grid{grid-template-columns:1fr}
.art{min-height:270px;order:-1}
.orb{width:210px;height:210px}
.code{font-size:70px}
