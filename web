.ico{font-size:32px;width:58px;height:58px;display:grid;place-items:center;background:#10264b;border:1px solid #2c58a5;border-radius:14px;margin-bottom:14px}
.service h3{margin:0 0 8px}
.service p{color:var(--muted);font-size:14px;line-height:1.9;margin:0}
.choose{display:block;text-align:center;margin-top:15px;border:1px solid #3d5aa7;color:#8fe4ff;border-radius:9px;padding:8px;font-weight:bold}
.choose:hover{background:#15305d}
.why{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
.why article{text-align:center;padding:20px 12px;background:#0a1024;border:1px solid #222f5e;border-radius:14px}
.why b{display:block;color:var(--blue);margin:9px}
