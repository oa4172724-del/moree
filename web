.order{max-width:760px;margin:auto;padding:clamp(20px,5vw,36px);border:1px solid #3e4a99;border-radius:20px;background:linear-gradient(140deg,#0d1732,#0b0b20);box-shadow:0 0 50px #5142ff14}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.field{display:flex;flex-direction:column;gap:8px}
.full{grid-column:1/-1}
.field label{font-size:14px;color:#d9e2ff}
.field input,.field select,.field textarea{width:100%;background:#060b1b;color:white;border:1px solid #34447c;border-radius:10px;padding:13px;outline:none}
