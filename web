<style>
:root{--bg:#050816;--panel:#0b1024;--blue:#00c8ff;--purple:#a855ff;--text:#f4f5ff;--muted:#a9b3d4}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:Cairo,Arial,sans-serif;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;background:radial-gradient(ellipse at 10% 15%,#063d7933,transparent 35%),radial-gradient(ellipse at 90% 45%,#6716a322,transparent 35%)}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit}
.container{width:min(1150px,92%);margin:auto}
header{position:sticky;top:0;z-index:20;background:#050816ef;backdrop-filter:blur(18px);border-bottom:1px solid #263568}
.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:72px}
.logo{font-weight:900;font-size:19px}
.logo b{color:var(--blue);font-size:30px;text-shadow:0 0 18px var(--blue);margin-left:8px}
.logo em{font-style:normal;color:var(--purple)}
.links{display:flex;gap:22px}
.links a{color:#c9d2ef;font-size:14px}
.links a:hover{color:var(--blue)}
.menu-btn{display:none;background:#111a36;color:white;border:1px solid #33467d;border-radius:9px;padding:7px 12px}
.btn{display:inline-flex;justify-content:center;align-items:center;gap:9px;padding:12px 20px;border-radius:12px;color:white;font-weight:800;border:1px solid #00c8ff;background:linear-gradient(110deg,#007eff,#6a35ed);box-shadow:0 0 20px #147bff36;cursor:pointer;transition:.25s}
.btn:hover{transform:translateY(-3px);box-shadow:0 0 28px #8b4dff66}
.green{background:linear-gradient(110deg,#0fcf76,#069e60);border-color:#27e68d}
.hero{padding:75px 0 55px}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:35px}
.badge{display:inline-block;padding:7px 14px;border:1px solid #176eaa;border-radius:30px;color:var(--blue);background:#00c8ff0c;font-size:13px}
h1{font-size:clamp(36px,5.5vw,64px);line-height:1.3;margin:18px 0;font-weight:900}
.gradient{background:linear-gradient(90deg,#00c8ff,#8e61ff,#d16cff);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--muted);line-height:2}
.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.quick{display:flex;flex-wrap:wrap;gap:17px;margin-top:25px;color:#c3cee9;font-size:13px}
.quick span{color:var(--blue)}
.art{min-height:310px;position:relative;display:grid;place-items:center}
.orb{width:250px;height:250px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#164f9c,#24124b 55%,#070b1b 75%);border:1px solid #3c68ff;box-shadow:0 0 50px #185bff44,inset 0 0 40px #8d42ff22;display:grid;place-items:center;animation:float 5s ease-in-out infinite}
.code{font:900 85px monospace;color:var(--blue);text-shadow:0 0 15px #00c8ff,0 0 35px #7b45ff}
.float{position:absolute;background:#0b1430ef;border:1px solid #4055a4;padding:12px 15px;border-radius:12px;animation:float 4s ease-in-out infinite}
.float strong{color:var(--blue)}
.f1{top:20px;right:0}
.f2{bottom:25px;left:0;animation-delay:1s}
.f3{top:45%;right:-8px;animation-delay:2s}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
section.content{padding:58px 0}
.head{text-align:center;margin-bottom:30px}
.head h2{font-size:clamp(25px,4vw,36px);margin:0 0 10px}
.head p{color:var(--muted);line-height:1.9}
.line{width:90px;height:3px;margin:15px auto;background:linear-gradient(90deg,var(--blue),var(--purple));box-shadow:0 0 15px #4a8cff;border-radius:5px}
